# Copy to .env and fill in if you want the natural-language explanation step
# to be phrased by a real model instead of the built-in template renderer.
# Everything else in this project (data gathering, decisioning, actions,
# validation) runs with or without these — they only affect the wording of
# the explanation shown in the UI.

# Optional. If set, agent.explain_with_llm() will call this provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use when a key is present: "openai" | "anthropic" | "none"
LLM_PROVIDER=none

# Server
PORT=8000
DATABASE_PATH=./purchasing_agent.db
